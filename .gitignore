# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec.bak

# Virtual environments
venv/
ENV/
env/
.venv/
.venv-*/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Local config
config.json
.env
.env.*
!.env.example
*.db

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Tracker binaries (downloaded during build)
resources/trackers/

# Generated at build time - must never be committed (would show wrong date in dev builds)
src/_build_info.py

# Generated at build time - bakes the error-reporting DSN into the bundle; never commit
src/_build_secrets.py

# Plans (local only)
plans.md
docs/plans/

# Working notes (local only)
AUDIT-FIX-PLAN.md
TRASH-FILES.md
TRASH/

# Claude local config
.claude/

# PyInstaller spec is regenerated; only the .bak was ignored before
*.spec

# pip install detritus when shell mis-parses '>='
=*

# Keep resources placeholder
!resources/.gitkeep
